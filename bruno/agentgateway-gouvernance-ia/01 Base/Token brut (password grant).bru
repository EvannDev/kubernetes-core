meta {
  name: Token brut (password grant)
  type: http
  seq: 3
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{username}}
  password: {{password}}
  scope: {{scopes}}
}

script:post-response {
  // Decode le JWT et affiche les claims qui pilotent toute la gouvernance.
  // Aucune dependance externe : le payload est du base64url.
  const token = res.getBody().access_token;
  bru.setVar("accessToken", token);

  const payload = JSON.parse(
    Buffer.from(token.split(".")[1].replace(/-/g, "+").replace(/_/g, "/"), "base64").toString("utf8")
  );

  console.log("sub     :", payload.sub);
  console.log("iss     :", payload.iss);
  console.log("aud     :", payload.aud);
  console.log("groups  :", payload.groups);
  console.log("scope   :", payload.scope);
  console.log("expire  :", new Date(payload.exp * 1000).toISOString());

  bru.setVar("tokenGroups", JSON.stringify(payload.groups));
  bru.setVar("tokenAud", JSON.stringify(payload.aud));
}

assert {
  res.status: eq 200
}

tests {
  test("le jeton porte l'audience exigee par la passerelle", function () {
    const aud = JSON.parse(bru.getVar("tokenAud"));
    const list = Array.isArray(aud) ? aud : [aud];
    expect(list).to.include("agentgateway");
  });

  test("le jeton porte le claim groups", function () {
    expect(JSON.parse(bru.getVar("tokenGroups"))).to.be.an("array").that.is.not.empty;
  });
}

docs {
  Le meme appel que `make token`, mais avec le payload decode dans la console
  Bruno : c'est la diapositive la plus utile de la presentation. Deux claims font
  tout le travail :

  - `aud: agentgateway` — produit par le client scope `agentgateway-audience`
    (`oidc-audience-mapper`). Sans lui, 401.
  - `groups: ["platform-admins"]` — produit par le client scope `groups`
    (`oidc-group-membership-mapper`, `full.path: "false"`). C'est ce que lisent
    les expressions CEL des `AgentgatewayModel` et des policies MCP.

  Cette requete n'est pas necessaire au reste de la collection (Bruno gere le
  jeton tout seul) : elle est la pour **montrer** le jeton.
}
