meta {
  name: JWKS (Keycloak)
  type: http
  seq: 2
}

get {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/certs
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
}

tests {
  test("au moins une cle de signature est publiee", function () {
    const keys = res.getBody().keys;
    expect(keys).to.be.an("array").that.is.not.empty;
    expect(keys.some((k) => k.use === "sig")).to.be.true;
  });
}

docs {
  Exactement ce que la passerelle va chercher, mais elle le fait **par le Service
  interne** (`kc-service.keycloak:8080`, `jwksPath` de la policy) et pas par le
  DNS public : la validation des jetons ne depend donc ni de la Gateway de
  plateforme ni de la resolution externe. `cacheDuration: 5m`.
}
